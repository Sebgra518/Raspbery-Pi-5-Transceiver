DEST_IP=your_receiver_ip

VIDEO_PORT=5005
AUDIO_PORT=5004

VIDEO_WIDTH=640
VIDEO_HEIGHT=480
VIDEO_FPS=15
JPEG_QUALITY=70

AUDIO_RATE=44100
AUDIO_CHANNELS=1
AUDIO_CHUNK=1024
AUDIO_INPUT_DEVICE=0

SOCKET_BUFFER=1048576

STREAM_KEY=your_64_hex_chars_here

# CRYPTO SETTINGS
# auto = use ARMv8 crypto
# off = disable (OPENSSL_armcap=0)
# custom = use CRYPTO_ARM_CAP value
CRYPTO_MODE=auto
CRYPTO_ARM_CAP=